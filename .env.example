# Gemini API Key hoặc 9router Token
# Tuyệt đối không chia sẻ key này ra ngoài
GEMINI_API_KEY=your_gemini_api_key_or_9router_token_here

# 9router Gateway Base URL (Mặc định: http://localhost:20128/v1)
# Để trống nếu muốn gọi thẳng tới Google AI Studio API
LLM_BASE_URL=http://localhost:20128/v1

# Mô hình sử dụng (Mặc định: ag/gemini-3.7-flash-high hoặc gemini-3.7-flash)
GEMINI_MODEL=ag/gemini-3.7-flash-high

# Cấu hình máy chủ Backend
HOST=0.0.0.0
PORT=8000
